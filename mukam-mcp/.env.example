# CISO Assistant API base URL, including the /api prefix
API_URL=https://grc.wathbah.dev/api

# Personal Access Token. Its owner must hold the administrator role, since the
# audit log spans every folder. Create one under: my profile -> settings
TOKEN=

# Set to false only for instances with a self-signed certificate
VERIFY_CERTIFICATE=true

# Bind address. Keep on localhost and expose through a reverse proxy: this
# server does not authenticate its callers.
MUKAM_MCP_HOST=127.0.0.1
MUKAM_MCP_PORT=8282

# Public URL the reverse proxy serves this on. Required when proxied, or
# requests are rejected with HTTP 421.
# MUKAM_MCP_PUBLIC_URL=https://grc.wathbah.dev

# URL path to serve on. Change it when sharing a hostname with another MCP
# server that already answers on /mcp.
# MUKAM_MCP_PATH=/mukam-mcp

# Ceiling on rows returned per call
# MUKAM_MCP_MAX_ENTRIES=200
