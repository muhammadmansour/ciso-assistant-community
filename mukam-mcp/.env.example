# Muhkam / CISO Assistant API base URL, including the /api prefix
API_URL=https://muhkam-grc.wathbah.dev/api

# Optional static PAT. Leave empty: callers sign in on the Muhkam login page
# and the server mints a token for that user (same as cli/ca_mcp_http.py).
TOKEN=

VERIFY_CERTIFICATE=true

MUKAM_MCP_HOST=127.0.0.1
MUKAM_MCP_PORT=8282

# Public origin (no path). Required for OAuth and to avoid HTTP 421 behind nginx.
MUKAM_MCP_PUBLIC_URL=https://muhkam-grc.wathbah.dev

# Nginx prefix. CISO MCP keeps /mcp; this server lives under /mukam-mcp
# so OAuth discovery does not collide.
MUKAM_MCP_PATH=/mukam-mcp

# Days each minted Personal Access Token stays valid on the backend
# MUKAM_MCP_PAT_EXPIRY_DAYS=30

# MUKAM_MCP_MAX_ENTRIES=200
