TOKEN=
VERIFY_CERTIFICATE=false
API_URL=http://localhost:8000/api

# Response bounding for list tools (rows per page, max rows, max characters)
# CA_MCP_PAGE_LIMIT=100
# CA_MCP_MAX_ITEMS=200
# CA_MCP_MAX_RESPONSE_CHARS=20000

# --- Only needed when running ca_mcp_http.py (remote HTTP/OAuth "custom connector") ---
# Public HTTPS URL this server is reachable at, e.g. https://mcp.example.com
# MCP_PUBLIC_URL=
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8181
# Days each per-user Personal Access Token minted during login stays valid
# MCP_PAT_EXPIRY_DAYS=30
