# CISO Assistant Backend Configuration
# This file is installed to /etc/ciso-assistant/backend.env

# Django settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=__GENERATE_ON_INSTALL__
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite)
DB_ENGINE=sqlite3
SQLITE_FILE=/opt/ciso-assistant/backend/db/ciso-assistant.sqlite3

# Application URL (for frontend callbacks)
CISO_ASSISTANT_URL=http://localhost:3000

# Email settings (configure as needed)
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@localhost

# Media and static files
MEDIA_ROOT=/opt/ciso-assistant/backend/media
STATIC_ROOT=/opt/ciso-assistant/backend/static

# Object storage backend (choose at most one)
# --- Amazon S3 / S3-compatible ---
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# --- Google Cloud Storage ---
# USE_GCS=False
# GS_BUCKET_NAME=
# GS_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/etc/ciso-assistant/gcs-service-account.json
# GS_LOCATION=                       # optional key prefix inside the bucket
# GS_SIGNED_URL_EXPIRATION_SECONDS=900

# Security settings
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://localhost:8443
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:8443

# Logging
LOG_LEVEL=INFO

# Muraji API (set MURAJI_API_BASE_URL to retarget all endpoints)
# MURAJI_API_BASE_URL=https://muraji-api.wathbah.dev
# MURAJI_ANALYSIS_API_URL=
# MURAJI_LIBRARIES_API_URL=
# MURAJI_ENTITY_EXTRACTION_API_URL=
# MURAJI_MAIL_API_URL=
